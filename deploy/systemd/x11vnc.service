# systemd user unit: half of Beeper's one-time sign-in surface (VNC view of
# the Xvfb display, loopback only). Never enable it at boot. It is started and
# stopped ONLY by deploy/signin-surface.sh, because a VNC view of a signed-in
# Beeper is equivalent to holding the account.
[Unit]
Description=x11vnc on loopback (one-time Beeper GUI sign-in)
Requires=xvfb.service
After=xvfb.service

[Service]
Environment=DISPLAY=:99
# Two locks, because loopback is not private on a shared host
# (docs/SHARED-HOST.md):
# - -auth: the display's cookie, minted by xvfb.service.
# - -passwdfile: the viewer password. Any local user can reach 127.0.0.1:5900,
#   and noVNC's 127.0.0.1:6080 in front of it, so VNC itself must demand a
#   password. signin-surface.sh mints a fresh one on every `up` and deletes it
#   on `down`. It is read from a file rather than passed as an argument, which
#   `ps` would show to every user. If the file is missing or empty, x11vnc
#   refuses to start, so the surface fails closed.
ExecStart=/usr/bin/x11vnc -display :99 -auth %t/claude-messenger/xauth -localhost -rfbport 5900 -forever -shared -passwdfile %t/claude-messenger/vncpasswd
Restart=always
RestartSec=5
# Stopped with SIGINT, which x11vnc turns into a clean exit from its main
# loop, with status 0. On SIGTERM it exits 2, which systemd counts as a failed
# stop, and its handler makes X calls of its own, which hang for good if the
# signal lands during one. Stopping this unit stops noVNC first, dropping any
# viewer, so the signal can come while x11vnc is still restoring the display
# after them, and a hang there lasts until systemd's stop timeout, 90 s by
# default, runs out.
KillSignal=SIGINT

# Kept so `systemctl disable` can clean up hosts provisioned before the
# surface was managed by deploy/signin-surface.sh (they enabled it at boot).
[Install]
WantedBy=default.target
