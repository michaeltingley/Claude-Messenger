# systemd SYSTEM unit for the hosted Claude Messenger MCP endpoint, run as
# the user who owns the install. deploy/configure.sh installs it into
# /etc/systemd/system, with the placeholders substituted.
#
# A system unit, though the rest of deploy/systemd/ are user units: the
# sandbox below needs a mount namespace, and a user manager can only build
# one inside an unprivileged user namespace. Ubuntu 24.04+ restricts those
# through AppArmor by default, and systemd then starts a user unit WITHOUT
# its sandbox, silently (seen on the VPS, 2026-10-13). The system manager
# builds the namespace with real privileges.
[Unit]
Description=Claude Messenger MCP server (HTTP)

[Service]
User=__USER__
WorkingDirectory=__INSTALL_DIR__
ExecStart=__NODE__ dist/cli/main.js serve --http --port __PORT__ --host 127.0.0.1
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
# The sandbox. Of the home directories and /run/user it sees only the install,
# read-only, and node. So a compromised server can't read SSH keys, other
# tools' credentials, Beeper's own data (its login token is a full API token)
# or the sign-in screen's X cookie and VNC password. It can change only its
# audit trail and rate window: every other file it sees is read-only, apart
# from a /tmp of its own. The home directories, /run/user, and the host's
# shared memory and message queues are swapped for empty, read-only
# stand-ins. Not ProtectHome=tmpfs: systemd 255 and 256 (Ubuntu 24.04 has
# 255) make its stand-ins writable. configure.sh refuses a .env that keeps
# the policy, audit trail or rate window anywhere else.
ProtectSystem=strict
TemporaryFileSystem=/home:ro /root:ro /run/user:ro /dev/shm:ro /dev/mqueue:ro
BindReadOnlyPaths=__INSTALL_DIR__ __NODE__
BindPaths=__INSTALL_DIR__/audit __INSTALL_DIR__/state
PrivateTmp=true
# Backstop for leaks on small hosts; normal footprint is well under this.
MemoryMax=512M

[Install]
WantedBy=multi-user.target
