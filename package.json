{
  "name": "claude-messenger",
  "version": "0.1.0",
  "description": "A policy-guarded bridge between Claude and your Beeper chats: provider-agnostic core, audit log, MCP server, and CLI.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20.12"
  },
  "bin": {
    "claude-messenger": "dist/cli/main.js"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build",
    "prepublishOnly": "npm run typecheck && npm test",
    "dev": "tsx src/cli/main.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "mcp": "tsx src/cli/main.ts serve"
  },
  "dependencies": {
    "@beeper/desktop-api": "^5.0.0",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "commander": "^13.1.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
