# Copy to .env (never committed) and fill in.

# Beeper access token. Get it with `npx claude-messenger connect`: you
# approve in Beeper's own window, and the token is saved here, never shown.
# Or mint one by hand in Beeper Desktop:
#   Settings -> Integrations -> enable "Beeper Desktop API"
#   Settings -> Integrations -> Approved connections -> "+" -> copy the token
BEEPER_ACCESS_TOKEN=

# Where the Beeper Desktop API is reachable FROM WHEREVER THIS PROCESS RUNS.
# - Same machine as Beeper Desktop (default): http://localhost:23373
# - Remote (e.g. Claude Code on the web reaching your desktop through a
#   Tailscale/cloudflared tunnel): https://<your-tunnel-host>
BEEPER_BASE_URL=http://localhost:23373

# Path to the policy file that controls what Claude may do.
CLAUDE_MESSENGER_POLICY=./policy.json

# Where the append-only audit log of every action is written.
CLAUDE_MESSENGER_AUDIT_DIR=./audit

# Mutable runtime state (send rate window). Keep separate from the audit dir.
CLAUDE_MESSENGER_STATE_DIR=./state

# How often `mentions` and `respond` search Beeper for new messages, in
# milliseconds (1000 to 60000, default 5000), besides taking what Beeper's
# push feed pushes at once. Lower notices sooner a message the feed misses,
# and asks Beeper more often.
# BEEPER_POLL_INTERVAL_MS=5000

# Only for hosted mode (`serve --http`): bearer token remote MCP clients
# must present. Generate with: openssl rand -hex 32
CLAUDE_MESSENGER_MCP_TOKEN=
